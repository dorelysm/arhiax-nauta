{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ErrorResponse.json",
  "title": "ErrorResponse",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "evaluation_id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "details": {
          "type": "array"
        },
        "message": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
